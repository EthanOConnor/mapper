{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "warnings": {
        "installAbsoluteDestination": true
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TEST_BUILD_DEPENDS": "ON",
        "Mapper_MANUAL_QTHELP": "OFF"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg/ports"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Mapper_DEVELOPMENT_BUILD": "OFF",
        "Mapper_PACKAGE_BUILD": "ON"
      }
    },
    {
      "name": "dev-vcpkg",
      "hidden": true,
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Mapper_DEVELOPMENT_BUILD": "ON"
      }
    },
    {
      "name": "dev-macos",
      "displayName": "macOS development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Mapper_DEVELOPMENT_BUILD": "ON"
      }
    },
    {
      "name": "release-macos",
      "displayName": "macOS local release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Mapper_DEVELOPMENT_BUILD": "OFF",
        "Mapper_PACKAGE_BUILD": "OFF"
      }
    },
    {
      "name": "dev-macos-sanitize",
      "displayName": "macOS development with ASan and UBSan",
      "inherits": "dev-macos",
      "cacheVariables": {
        "Mapper_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ios",
      "hidden": true,
      "inherits": "base",
      "generator": "Xcode",
      "toolchainFile": "$env{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CMAKE_XCODE_ATTRIBUTE_DEAD_CODE_STRIPPING": "YES",
        "CMAKE_XCODE_ATTRIBUTE_SUPPORTS_MACCATALYST": "NO",
        "CMAKE_XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY": "1,2",
        "Mapper_BUILD_API_DOCS": "OFF",
        "Mapper_BUILD_MANUAL": "OFF",
        "Mapper_DEVELOPMENT_BUILD": "OFF",
        "Mapper_PACKAGE_BUILD": "OFF",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "QT_USE_VCPKG": "ON",
        "VCPKG_HOST_TRIPLET": "arm64-osx-release",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg/ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg/triplets"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device (arm64)",
      "inherits": "ios",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "Rust_CARGO_TARGET": "aarch64-apple-ios",
        "VCPKG_TARGET_TRIPLET": "arm64-ios-release"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS Simulator (x86_64)",
      "inherits": "ios",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "MANUAL_SECTIONS": "IOS",
        "Mapper_BUILD_MANUAL": "ON",
        "Rust_CARGO_TARGET": "x86_64-apple-ios",
        "VCPKG_TARGET_TRIPLET": "x64-ios-simulator-release"
      }
    },
    {
      "name": "ios-release",
      "displayName": "iOS signed release archive",
      "inherits": "ios-device",
      "cacheVariables": {
        "MANUAL_SECTIONS": "IOS",
        "Mapper_BUILD_MANUAL": "ON",
        "Mapper_PACKAGE_BUILD": "ON"
      }
    },
    {
      "name": "dev-linux",
      "displayName": "Linux development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Mapper_DEVELOPMENT_BUILD": "ON"
      }
    },
    {
      "name": "dev-windows",
      "displayName": "Windows development",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Mapper_DEVELOPMENT_BUILD": "ON"
      }
    },
    {
      "name": "dev-macos-vcpkg",
      "displayName": "macOS development with managed dependencies",
      "inherits": "dev-vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "dev-linux-vcpkg",
      "displayName": "Linux development with managed dependencies",
      "inherits": "dev-vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "dev-windows-vcpkg",
      "displayName": "Windows development with managed dependencies",
      "inherits": "dev-vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "Linux CI",
      "inherits": "ci",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "ci-macos",
      "displayName": "macOS CI",
      "inherits": "ci",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-release"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "Windows CI",
      "inherits": "ci",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release"
      }
    },
    {
      "name": "ci-android",
      "displayName": "Android CI",
      "inherits": "base",
      "toolchainFile": "$env{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "Mapper_DEVELOPMENT_BUILD": "OFF",
        "Mapper_PACKAGE_BUILD": "ON",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "QT_USE_VCPKG": "ON",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg/ports",
        "VCPKG_TARGET_TRIPLET": "arm64-android-release"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-macos", "configurePreset": "dev-macos" },
    { "name": "release-macos", "configurePreset": "release-macos" },
    { "name": "ios-device", "configurePreset": "ios-device", "configuration": "Release" },
    { "name": "ios-simulator", "configurePreset": "ios-simulator", "configuration": "Release" },
    { "name": "ios-release", "configurePreset": "ios-release", "configuration": "Release" },
    { "name": "dev-macos-sanitize", "configurePreset": "dev-macos-sanitize" },
    { "name": "dev-linux", "configurePreset": "dev-linux" },
    { "name": "dev-windows", "configurePreset": "dev-windows", "configuration": "Debug" },
    { "name": "dev-macos-vcpkg", "configurePreset": "dev-macos-vcpkg" },
    { "name": "dev-linux-vcpkg", "configurePreset": "dev-linux-vcpkg" },
    { "name": "dev-windows-vcpkg", "configurePreset": "dev-windows-vcpkg", "configuration": "Debug" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-macos", "configurePreset": "ci-macos" },
    { "name": "ci-windows", "configurePreset": "ci-windows", "configuration": "Release" },
    { "name": "ci-android", "configurePreset": "ci-android" }
  ],
  "testPresets": [
    {
      "name": "dev-macos",
      "configurePreset": "dev-macos",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-macos-sanitize",
      "configurePreset": "dev-macos-sanitize",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-linux",
      "configurePreset": "dev-linux",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-windows",
      "configurePreset": "dev-windows",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-macos-vcpkg",
      "configurePreset": "dev-macos-vcpkg",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-linux-vcpkg",
      "configurePreset": "dev-linux-vcpkg",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-windows-vcpkg",
      "configurePreset": "dev-windows-vcpkg",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
